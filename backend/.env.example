# FraudxAI Environment Variables
# Copy to .env in your backend/ or project root

# Primary LLM Provider: Featherless.ai
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Secondary Fallback Provider: Groq Cloud
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Optional: Adaption Labs (when credits are activated)
ADAPTION_API_KEY=
ADAPTION_BASE_URL=https://api.adaption.ai/v1
ADAPTION_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Provider Prioritization: "featherless", "adaption", or "groq"
PRIMARY_PROVIDER=featherless

# Timeout Budgets (seconds)
LLM_TIMEOUT_PRIMARY=10.0
LLM_TIMEOUT_FALLBACK=4.0
